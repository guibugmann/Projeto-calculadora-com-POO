unit UPote;

interface

uses
UOperacao;

Type
  TPote= class(TOperacao)
  public
    function Calcular: Double; override;
  end;

implementation

function TPote.Calcular: Double;
var
guardar: Double;
i: Integer;
begin
guardar:= 1;
for i := 1 to Trunc(valor2) do
    begin
    guardar:=guardar*valor1;
    end;
    Result:=guardar;
end;
end.
